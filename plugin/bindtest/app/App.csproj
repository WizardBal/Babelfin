<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Plays the Jellyfin 12.2 server: its assemblies come from the 12.2.0 NuGet packages, runtime assets included,
       so they sit in this app's output and load in the default context, exactly like on the server. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>BindTest</AssemblyName>
    <NoWarn>ASP0000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Common" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Data" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.2.0" />
  </ItemGroup>
</Project>
