<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Babelfin</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Babelfin</AssemblyName>
    <Version>0.19.0.0</Version>
    <AssemblyVersion>0.19.0.0</AssemblyVersion>
    <FileVersion>0.19.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Only our own DLL ships; Jellyfin supplies everything else at runtime. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Compile against Jellyfin's published 12.0.0 plugin API (the targetAbi floor). ExcludeAssets="runtime" keeps them out of the output. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Common" Version="12.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" LogicalName="Babelfin.configPage.html" />
    <!-- Normalize resource names for identical Windows and Linux builds. -->
    <EmbeddedResource Include="Assets/**/*" LogicalName="Babelfin.$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
